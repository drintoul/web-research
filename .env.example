# Public bindings (loopback by default)
GATEWAY_PORT=8080
MCP_PORT=8081

# Optional shared API key for REST gateway. Leave blank only on a trusted host/network.
GATEWAY_API_KEY=change-me

# Firecrawl images. For production, replace 'latest' with an exact, tested tag/digest.
FIRECRAWL_VERSION=latest
FIRECRAWL_API_IMAGE=ghcr.io/firecrawl/firecrawl
FIRECRAWL_PLAYWRIGHT_IMAGE=ghcr.io/firecrawl/playwright-service
FIRECRAWL_NUQ_POSTGRES_IMAGE=ghcr.io/firecrawl/nuq-postgres

# Firecrawl runtime
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=postgres
NUM_WORKERS_PER_QUEUE=4
CRAWL_CONCURRENT_REQUESTS=6
MAX_CONCURRENT_JOBS=4
BROWSER_POOL_SIZE=4
BLOCK_MEDIA=true
LOGGING_LEVEL=info

# Existing external SearXNG container. This project does NOT start SearXNG.
# The default assumes your SearXNG container publishes port 8088 on the Docker host.
SEARXNG_ENDPOINT=http://host.docker.internal:8088
SEARXNG_ENGINES=
SEARXNG_CATEGORIES=general

# Existing external Ollama service/container. This project does NOT start Ollama.
# The default assumes Ollama is reachable on port 11434 on the Docker host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_TIMEOUT_SECONDS=120

# Extract service
EXTRACT_MAX_RETRIES=2
EXTRACT_MAX_CONTENT_CHARS=250000

# Interact service
INTERACT_MAX_SESSIONS=6
INTERACT_SESSION_TTL_SECONDS=900
INTERACT_NAVIGATION_TIMEOUT_MS=30000
INTERACT_MAX_TEXT_CHARS=50000
INTERACT_LLM_SELECTOR_FALLBACK=true
INTERACT_BLOCK_MEDIA=true

# Set comma-separated hostnames only when you intentionally need them.
# Example: INTERACT_HOST_ALLOWLIST=example.com,www.example.com
INTERACT_HOST_ALLOWLIST=
